# 生产环境截图服务 Dockerfile（基于 Playwright，比 Selenium 更轻量）
FROM mcr.microsoft.com/playwright/java:v1.49.0-noble

WORKDIR /app

# Playwright 官方镜像已包含浏览器运行依赖。这里不再执行 apt-get，
# 避免 GitHub Actions 构建时因 Ubuntu apt 源波动导致截图服务镜像构建失败。

# 创建非root用户
RUN groupadd -r spring && useradd -r -g spring spring

# 创建必要的目录并设置权限
RUN mkdir -p /tmp/screenshots /logs /home/spring/.dubbo && \
    chown -R spring:spring /tmp/screenshots /logs /home/spring

USER spring:spring

# 复制构建好的jar文件
COPY screenshot-service.jar app.jar

# 环境变量
ENV SPRING_PROFILES_ACTIVE=docker
ENV JAVA_OPTS="-Xmx512m -Xms256m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError"
ENV CODE_CRAFT_MYSQL_HOST=mysql
ENV CODE_CRAFT_MYSQL_PORT=3306
ENV CODE_CRAFT_MYSQL_DATABASE=ai_code_gen
ENV CODE_CRAFT_MYSQL_USERNAME=ai_code_gen_user
ENV CODE_CRAFT_MYSQL_PASSWORD=""
ENV CODE_CRAFT_REDIS_HOST=redis
ENV CODE_CRAFT_REDIS_PORT=6379
ENV CODE_CRAFT_REDIS_PASSWORD=""
ENV CODE_CRAFT_NACOS_HOST=nacos
ENV CODE_CRAFT_NACOS_PORT=8848
ENV CODE_CRAFT_NACOS_USERNAME=nacos
ENV CODE_CRAFT_NACOS_PASSWORD=""
ENV TENCENT_COS_SECRET_ID=""
ENV TENCENT_COS_SECRET_KEY=""
ENV TENCENT_COS_REGION=""
ENV TENCENT_COS_BUCKET=""
ENV TENCENT_COS_HOST=""

# 暴露端口
EXPOSE 8127

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8127/api/actuator/health || exit 1

# 启动应用
ENTRYPOINT ["sh", "-c", "java ${JAVA_OPTS} -jar app.jar"]
